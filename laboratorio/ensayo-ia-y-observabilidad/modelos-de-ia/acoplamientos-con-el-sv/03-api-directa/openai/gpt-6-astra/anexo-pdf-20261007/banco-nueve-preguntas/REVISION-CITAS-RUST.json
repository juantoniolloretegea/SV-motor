            "identificador_cotejado": "PDF-P0003",
            "lista_de_citas": false,
            "pagina_fisica": 4,
            "seccion_recibida": "PDF-P0003 — Citometría de flujo",
            "titulo_documental_cotejado": "Citometría de flujo"
          },
          {
            "citas": [
              {
                "conforme": true,
                "elipsis_explicitas": 0,
                "normalizacion": "sólo espacios; omisiones [...] comprobadas por segmentos literales ordenados; no semejanza",
                "segmentos": [
                  {
                    "fin_utf8_texto_normalizado": 1374,
                    "inicio_utf8_texto_normalizado": 1094,
                    "texto": "En casi todos los casos de leucemia de células peludas, las células leucémicas tienen una mutación en el gen BRAF V600E. Esta mutación puede servir como marcador molecular confiable para diferenciar la leucemia de células peludas de otras leucemias y linfomas de células B."
                  }
                ]
              }
            ],
            "fragmentos": [
              {
                "fin_caracter_exclusivo": 2000,
                "indice": 0,
                "inicio_caracter": 0
              }
            ],
            "identificador_cotejado": "PDF-P0003",
            "lista_de_citas": false,
            "pagina_fisica": 4,
            "seccion_recibida": "PDF-P0003 — Pruebas moleculares",
            "titulo_documental_cotejado": "Pruebas moleculares"
          },
          {
            "citas": [
              {
                "conforme": true,
                "elipsis_explicitas": 0,
                "normalizacion": "sólo espacios; omisiones [...] comprobadas por segmentos literales ordenados; no semejanza",
                "segmentos": [
                  {
                    "fin_utf8_texto_normalizado": 1709,
                    "inicio_utf8_texto_normalizado": 1528,
                    "texto": "Aproximadamente del 80% al 90% de los pacientes con leucemia de células peludas tienen una hipermutación en un gen de la región variable de la cadena pesada de la inmunoglobulina"
                  }
                ]
              }
            ],
            "fragmentos": [
              {
                "fin_caracter_exclusivo": 2000,
                "indice": 0,
                "inicio_caracter": 0
              },
              {
                "fin_caracter_exclusivo": 4000,
                "indice": 1,
                "inicio_caracter": 2000
              }
            ],
            "identificador_cotejado": "PDF-P0003",
            "lista_de_citas": false,
            "pagina_fisica": 4,
            "seccion_recibida": "PDF-P0003 — Pruebas moleculares",
