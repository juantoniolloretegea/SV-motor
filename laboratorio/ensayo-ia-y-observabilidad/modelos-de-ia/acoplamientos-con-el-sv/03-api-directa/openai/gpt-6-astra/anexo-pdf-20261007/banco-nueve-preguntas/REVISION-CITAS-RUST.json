                "segmentos": [
                  {
                    "fin_utf8_texto_normalizado": 434,
                    "inicio_utf8_texto_normalizado": 294,
                    "texto": "Si no es posible realizar una aspiración, el médico puede examinar la muestra de la biopsia de médula ósea a fin de detectar anomalías."
