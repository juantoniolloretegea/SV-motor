                  {
                    "fin_utf8_texto_normalizado": 373,
                    "inicio_utf8_texto_normalizado": 243,
                    "texto": "en el 2008, la Organización Mundial de la Salud llegó a la conclusión de que constituye una enfermedad biológicamente distinta"
                  }
                ]
              },
              {
                "conforme": true,
                "elipsis_explicitas": 0,
                "normalizacion": "sólo espacios; omisiones [...] comprobadas por segmentos literales ordenados; no semejanza",
                "segmentos": [
                  {
                    "fin_utf8_texto_normalizado": 599,
                    "inicio_utf8_texto_normalizado": 508,
                    "texto": "presenta un curso clínico diferente y los tratamientos para esta enfermedad son distintos."
                  }
                ]
              },
              {
                "conforme": true,
                "elipsis_explicitas": 0,
                "normalizacion": "sólo espacios; omisiones [...] comprobadas por segmentos literales ordenados; no semejanza",
                "segmentos": [
                  {
                    "fin_utf8_texto_normalizado": 689,
                    "inicio_utf8_texto_normalizado": 616,
                    "texto": "esta hoja informativa no abarca la leucemia variante de células peludas."
                  }
                ]
              }
            ],
