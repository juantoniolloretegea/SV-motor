                "segmentos": [
                  {
                    "fin_utf8_texto_normalizado": 229,
                    "inicio_utf8_texto_normalizado": 133,
                    "texto": "Inicialmente se pensó que esta variante constituía un subtipo de leucemia de células peludas."
                  }
                ]
              },
