                  {
                    "fin_utf8_texto_normalizado": 932,
                    "inicio_utf8_texto_normalizado": 766,
                    "texto": "Además de los antígenos CD19, CD20 y CD22, presentes en las células B, las células de esta enfermedad también expresan los antígenos CD11c, CD25, CD103 y CD123."
                  }
                ]
              }
            ],
            "fragmentos": [
              {
                "fin_caracter_exclusivo": 2000,
                "indice": 0,
