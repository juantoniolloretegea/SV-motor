            "seccion_recibida": "PDF-P0003 — Pruebas moleculares",
            "titulo_documental_cotejado": "Pruebas moleculares"
          },
          {
            "citas": [
              {
                "conforme": true,
                "elipsis_explicitas": 1,
                "normalizacion": "sólo espacios; omisiones [...] comprobadas por segmentos literales ordenados; no semejanza",
                "segmentos": [
                  {
                    "fin_utf8_texto_normalizado": 1632,
                    "inicio_utf8_texto_normalizado": 1501,
